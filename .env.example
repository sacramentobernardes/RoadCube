# Copie para .env.local e preencha. O .env.local nunca vai para o git.
# Supabase: painel do projeto → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable/anon). É segura no navegador porque o RLS protege os dados.
# NUNCA coloque a service_role/secret key aqui: o app não precisa dela.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do app, usada nos links de confirmação de e-mail e no retorno do Google.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mostra o botão "Continuar com Google". Ative só depois de configurar o provedor no Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
